---
import { faGithub, faInstagram, faLinkedin } from "@fortawesome/free-brands-svg-icons";
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const sectionId = content.lang === "es" ? "equipo" : "team";
const webIcon = {
  icon: [
    24,
    24,
    [],
    "",
    "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.93 9h-3.07a15.5 15.5 0 0 0-1.18-5.02A8.03 8.03 0 0 1 18.93 11ZM12 4.04c.83 1.2 1.48 3.02 1.78 4.96h-3.56C10.52 7.06 11.17 5.24 12 4.04ZM4.26 13h3.88c.13 1.78.53 3.46 1.18 5.02A8.03 8.03 0 0 1 4.26 13Zm3.88-2H4.26a8.03 8.03 0 0 1 5.06-5.02A15.5 15.5 0 0 0 8.14 11ZM12 19.96c-.83-1.2-1.48-3.02-1.78-4.96h3.56c-.3 1.94-.95 3.76-1.78 4.96ZM14.14 13h-4.28a18.4 18.4 0 0 1 0-2h4.28a18.4 18.4 0 0 1 0 2Zm.54 5.02c.65-1.56 1.05-3.24 1.18-5.02h3.88a8.03 8.03 0 0 1-5.06 5.02Z",
  ],
};
const socialIcons = {
  Web: webIcon,
  Instagram: faInstagram,
  LinkedIn: faLinkedin,
  GitHub: faGithub,
};
---

<section id={sectionId} class="bg-ink py-20 text-white sm:py-24">
  <div class="section-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">Team</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold sm:text-5xl">{content.team.title}</h2>
      <p class="mt-4 text-lg leading-8 text-white/68">{content.team.copy}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        content.team.members.map((member) => (
          <article class="rounded-lg border border-flame/20 bg-panel p-5 shadow-soft">
            <img
              class="aspect-square w-full rounded-md border-4 border-flame/70 object-cover"
              src={member.image}
              alt={member.name}
              loading="lazy"
            />
            <h3 class="mt-5 text-xl font-extrabold">{member.name}</h3>
            <p class="mt-1 font-bold text-flame">{member.role}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {
                member.links.map((link) => {
                  const icon = socialIcons[link.label];
                  const paths = Array.isArray(icon.icon[4]) ? icon.icon[4] : [icon.icon[4]];

                  return (
                    <a
                      class="grid size-10 place-items-center rounded-md border border-nitro/45 text-white transition hover:border-nitro hover:bg-nitro hover:text-ink"
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${member.name} ${link.label}`}
                      title={link.label}
                    >
                      <svg class="size-[19px]" viewBox={`0 0 ${icon.icon[0]} ${icon.icon[1]}`} fill="currentColor" aria-hidden="true">
                        {paths.map((path) => (
                          <path d={String(path)}></path>
                        ))}
                      </svg>
                    </a>
                  );
                })
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
