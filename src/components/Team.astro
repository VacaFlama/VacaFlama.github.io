---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const sectionId = content.lang === "es" ? "equipo" : "team";
---

<section id={sectionId} class="bg-ink py-20 text-white sm:py-24">
  <div class="section-shell">
    <div class="max-w-3xl">
      <p class="section-kicker text-flame">Team</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold sm:text-5xl">{content.team.title}</h2>
      <p class="mt-4 text-lg leading-8 text-white/70">{content.team.copy}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        content.team.members.map((member) => (
          <article class="rounded-lg border border-white/10 bg-white/[0.06] p-5">
            <img
              class="aspect-square w-full rounded-md object-cover"
              src={member.image}
              alt={member.name}
              loading="lazy"
            />
            <h3 class="mt-5 text-xl font-extrabold">{member.name}</h3>
            <p class="mt-1 text-flame">{member.role}</p>
            {
              member.instagram ? (
                <a
                  class="mt-5 inline-flex rounded-full border border-white/20 px-4 py-2 text-sm font-bold text-white/80 transition hover:border-flame hover:text-flame"
                  href={member.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {content.team.socialLabel}
                </a>
              ) : null
            }
          </article>
        ))
      }
    </div>
  </div>
</section>
