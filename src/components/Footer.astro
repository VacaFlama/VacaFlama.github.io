---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
---

<footer class="bg-ink py-8 text-white/70">
  <div class="section-shell flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:justify-between">
    <p>{content.footer.copyright}</p>
    <a class="font-bold text-white transition hover:text-flame" href={content.lang === "es" ? "/" : "/en/"}>
      VacaFlama
    </a>
  </div>
</footer>
