---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const sectionId = content.lang === "es" ? "proyectos" : "projects";
---

<section id={sectionId} class="bg-ink py-20 text-white sm:py-24">
  <div class="section-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">{content.projects.eyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold sm:text-5xl">{content.projects.title}</h2>
      <p class="mt-4 text-lg leading-8 text-white/68">{content.projects.copy}</p>
    </div>
    <div class="mt-12 grid gap-7 lg:grid-cols-3">
      {
        content.projects.items.map((project) => (
          <article class="group overflow-hidden rounded-lg border border-flame/20 bg-asphalt shadow-soft transition duration-300 hover:-translate-y-1 hover:border-flame/60">
            <div class="aspect-[4/3] overflow-hidden bg-black">
              <img
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                src={project.cover}
                alt={project.title}
                loading="lazy"
              />
            </div>
            <div class="flex min-h-[25rem] flex-col p-6">
              <p class="text-sm font-extrabold uppercase tracking-wide text-flame">{project.tagline}</p>
              <h3 class="mt-3 font-display text-2xl font-extrabold text-white">{project.title}</h3>
              <p class="mt-4 flex-1 leading-7 text-white/68">{project.description}</p>
              <dl class="mt-6 space-y-2 border-t border-flame/20 pt-5 text-sm">
                <div class="flex justify-between gap-4">
                  <dt class="font-bold text-horn">{content.projects.genreLabel}</dt>
                  <dd class="text-right text-white/68">{project.genre}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="font-bold text-horn">{content.projects.releaseLabel}</dt>
                  <dd class="text-right text-white/68">{project.release}</dd>
                </div>
              </dl>
              {
                project.link ? (
                  <a
                    class="mt-6 inline-flex w-fit items-center rounded-md bg-flame px-5 py-2.5 text-sm font-extrabold uppercase tracking-wide text-white transition hover:bg-ember"
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {content.projects.cta}
                  </a>
                ) : null
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
