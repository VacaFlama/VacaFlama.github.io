---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const sectionId = content.lang === "es" ? "quienes-somos" : "about";
---

<section id={sectionId} class="bg-asphalt py-20 text-white sm:py-24">
  <div class="section-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div>
      <p class="section-kicker">VacaFlama</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold sm:text-5xl">{content.about.title}</h2>
      <img class="mt-8 w-full max-w-sm rounded-lg border border-flame/30 bg-ink p-4 shadow-brand" src={content.hero.mark} alt="" aria-hidden="true" />
    </div>
    <div class="space-y-6">
      {
        content.about.paragraphs.map((paragraph) => (
          <p class="text-lg leading-8 text-white/72">{paragraph}</p>
        ))
      }
      <div class="flex flex-wrap gap-3 pt-2">
        {
          content.about.highlights.map((highlight) => (
            <span class="rounded-md border border-blush/35 bg-flame/10 px-4 py-2 text-sm font-extrabold text-white">
              {highlight}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
