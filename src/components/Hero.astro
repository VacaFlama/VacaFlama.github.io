---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
---

<section
  class="relative isolate flex min-h-[94vh] items-end overflow-hidden bg-ink pt-28 text-white"
  style={`background-image: radial-gradient(circle at 18% 42%, rgba(242, 11, 28, 0.44), transparent 28%), linear-gradient(90deg, rgba(8, 5, 4, 0.96), rgba(8, 5, 4, 0.78) 44%, rgba(8, 5, 4, 0.18)), url('${content.hero.background}'); background-size: cover; background-position: center;`}
>
  <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-ink to-transparent"></div>
  <div class="section-shell relative pb-16 pt-20 sm:pb-20 lg:pb-24">
    <div class="max-w-4xl">
      <img class="mb-8 h-auto w-full max-w-[29rem] object-contain sm:max-w-[38rem]" src={content.hero.logo} alt={content.hero.title} />
      <p class="section-kicker text-flame drop-shadow">{content.hero.eyebrow}</p>
      <h1 class="sr-only">{content.hero.title}</h1>
      <p class="mt-6 max-w-2xl text-xl font-semibold leading-8 text-white sm:text-2xl">
        {content.hero.copy}
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a
          class="rounded-md bg-flame px-6 py-3 text-sm font-extrabold uppercase tracking-wide text-white shadow-brand transition hover:bg-ember"
          href={content.nav[0]?.href}
        >
          {content.hero.primaryCta}
        </a>
        <a
          class="rounded-md border border-horn/70 px-6 py-3 text-sm font-extrabold uppercase tracking-wide text-white transition hover:border-horn hover:bg-horn hover:text-ink"
          href={content.nav[2]?.href}
        >
          {content.hero.secondaryCta}
        </a>
      </div>
    </div>
  </div>
</section>
