---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
---

<section
  class="relative isolate flex min-h-[92vh] items-end overflow-hidden bg-ink pt-28 text-white"
  style={`background-image: linear-gradient(90deg, rgba(17, 24, 39, 0.92), rgba(17, 24, 39, 0.68), rgba(17, 24, 39, 0.22)), url('${content.hero.background}'); background-size: cover; background-position: center;`}
>
  <div class="section-shell pb-16 pt-20 sm:pb-20 lg:pb-24">
    <div class="max-w-3xl">
      <img class="mb-8 h-20 w-auto sm:h-24" src={content.hero.logo} alt="" aria-hidden="true" />
      <p class="section-kicker text-flame">{content.hero.eyebrow}</p>
      <h1 class="mt-5 font-display text-5xl font-extrabold leading-tight sm:text-7xl lg:text-8xl">
        {content.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-white/82 sm:text-xl">
        {content.hero.copy}
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a
          class="rounded-full bg-flame px-6 py-3 text-sm font-bold uppercase tracking-wide text-white shadow-soft transition hover:bg-ember"
          href={content.nav[0]?.href}
        >
          {content.hero.primaryCta}
        </a>
        <a
          class="rounded-full border border-white/40 px-6 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:border-white hover:bg-white hover:text-ink"
          href={content.nav[2]?.href}
        >
          {content.hero.secondaryCta}
        </a>
      </div>
    </div>
  </div>
</section>
