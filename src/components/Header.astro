---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-flame/25 bg-ink/90 text-white shadow-brand backdrop-blur">
  <nav class="section-shell flex min-h-20 items-center justify-between gap-5 py-3" aria-label="Primary">
    <a class="flex items-center gap-3" href={content.lang === "es" ? "/" : "/en/"}>
      <img class="h-12 w-auto max-w-[12rem] object-contain sm:max-w-[15rem]" src={content.hero.logo} alt="VacaFlama" />
    </a>
    <div class="flex flex-wrap items-center justify-end gap-3 text-sm font-semibold sm:gap-5">
      {
        content.nav.map((item) => (
          <a class="text-white/78 transition hover:text-flame" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a
        class="rounded-full border border-flame/50 px-3 py-1.5 text-white transition hover:border-flame hover:bg-flame"
        href={content.alternateHref}
        aria-label={`${content.languageLabel}: ${content.alternateLabel}`}
      >
        {content.alternateLabel}
      </a>
    </div>
  </nav>
</header>
