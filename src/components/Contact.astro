---
import type { SiteContent } from "../data/site";

type Props = {
  content: SiteContent;
};

const { content } = Astro.props;
const sectionId = content.lang === "es" ? "contacto" : "contact";
---

<section id={sectionId} class="bg-ink py-20 text-white sm:py-24">
  <div class="section-shell">
    <div class="rounded-lg border border-flame/30 bg-[radial-gradient(circle_at_80%_20%,rgba(107,179,242,0.20),transparent_30%),linear-gradient(135deg,#151010,#030304_65%)] p-8 shadow-brand sm:p-12">
      <p class="section-kicker">{content.contact.title}</p>
      <div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="font-display text-3xl font-extrabold sm:text-5xl">{content.contact.copy}</h2>
          <p class="mt-4 text-lg text-white/70">{content.contact.email}</p>
        </div>
        <a
          class="inline-flex w-fit rounded-md bg-flame px-6 py-3 text-sm font-extrabold uppercase tracking-wide text-white transition hover:bg-ember"
          href={`mailto:${content.contact.email}`}
        >
          {content.contact.emailLabel}
        </a>
      </div>
    </div>
  </div>
</section>
